# Copiez ce fichier en ".env" (jamais commité) et renseignez les valeurs.

# --- Administration -----------------------------------------------------------------
# Adresses e-mail administrateur (séparées par des virgules). L'admin se connecte avec Google.
ADMIN_EMAILS="mughenyakavale@gmail.com"
# Facultatif : mot de passe de secours du premier admin (12 caractères minimum).
# Laissez vide pour n'autoriser que la connexion Google.
ADMIN_PASSWORD=""

# --- Serveur ------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
# Où sont conservées les données :
# - FIREBASE_SERVICE_ACCOUNT renseigné : dans Firestore (hébergement sans disque persistant).
#   Collez le contenu complet du fichier JSON de clé de compte de service (ou sa version base64).
# - laissé vide : dans un fichier du dossier DATA_DIR (développement, ou serveur avec disque).
FIREBASE_SERVICE_ACCOUNT=""
DATA_DIR="./data"
# Nombre de proxys devant le serveur (1 pour Cloud Run / Nginx, 0 si exposé directement).
TRUST_PROXY="1"

# --- E-mails de compte (confirmation d'adresse, mot de passe oublié) -------------------
# Compte gratuit Brevo (https://www.brevo.com) : SMTP & API → Clés API.
# Sans ces deux valeurs, aucun e-mail ne part : en développement le lien s'affiche dans la console.
BREVO_API_KEY=""
# Adresse d'expéditeur, à valider dans Brevo (Expéditeurs, domaines et IP dédiées).
MAIL_FROM=""
# MAIL_FROM_NAME="Gomarché"
# Adresse publique du site, utilisée dans les liens envoyés par e-mail (sans / final).
# Par défaut : le premier nom de ALLOWED_HOSTS en https.
PUBLIC_URL=""

# --- Connexion Google ---------------------------------------------------------------
# Par défaut, le projet de firebase-applet-config.json est utilisé.
# FIREBASE_PROJECT_ID="gomarche-c2476"

# --- Anti-robots (facultatif, recommandé) --------------------------------------------
# Clés Cloudflare Turnstile (gratuit) : https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Reconnaissance photo des produits (facultatif) -----------------------------------
# Sans clé, la recherche de photos par nom reste disponible.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# --- Validation automatique des paiements (facultatif) --------------------------------
# Secret partagé avec votre agrégateur Mobile Money pour signer POST /api/payments/webhook.
PAYMENT_WEBHOOK_SECRET=""
